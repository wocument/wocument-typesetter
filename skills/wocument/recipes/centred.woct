%% A centred feature theme: definitions only (theme: ./centred.woct).
%% A white page with a centred header: a tracked label over a heavy and a hairline rule, a
%% medium-weight sans headline, an italic serif deck and a small upper-case byline, all centred.
%% The text is a light grotesque, justified in three columns, with sentence-case crossheads
%% and a serif drop cap. Inter and Newsreader ship with the typesetter: no font files needed.

\token[name=navy, value=#001722]
\palette[name=default, paper=#ffffff, ink=#231f20, muted=#5f6570, accent=$navy, rule=#c9ced3]

\grid[name=default, cols=12, gutter=32px, margin-x=96px, margin-y=1.5bl, max=1960px, baseline=31px, body=1-12]
\grid[name=default, at=compact, gutter=26px, margin-x=64px, margin-y=1.5bl, max=1560px, baseline=26px]
\grid[name=default, at=tablet, cols=8, gutter=20px, margin-x=40px, margin-y=1.5bl, baseline=27px, body=1-8]
\grid[name=default, at=phone, cols=4, gutter=14px, margin-x=20px, margin-y=1bl, baseline=26px, body=all]

%% ---------- text ----------
\style[name=body, family="Inter, Helvetica Neue, sans-serif", weight=380, size=20px, leading=1bl, align=justify, indent=1.5em, space-after=0, hang=punctuation, composer=paragraph, hyphenate-min=6]
\style[name=body, at=compact, size=16px]
\style[name=body, at=tablet, size=17px]
\style[name=body, at=phone, size=17px, align=left]
\style[name=subhead, family="Inter, Helvetica Neue, sans-serif", weight=600, size=1.05em, leading=1bl, case=none, tracking=0, color=ink, space-before=1bl, space-after=0, keep-with-next, hyphenate=false]
\style[name=dropcap, family="Newsreader, Georgia, serif", weight=600, color=$navy]

%% ---------- the centred header ----------
\style[name=kicker, family="Inter, Helvetica Neue, sans-serif", weight=400, size=12px, case=upper, tracking=0.32em, color=muted, align=center, space-after=0.5bl, snap=none]
\style[name=headline, family="Inter, Helvetica Neue, sans-serif", weight=500, size=fluid(30px, 54px), leading=1.1em, tracking=-0.015em, color=ink, align=center, balance, bind-short, hyphenate=false, space-after=0.25bl, snap=none]
\style[name=deck, family="Newsreader, Georgia, serif", italic, weight=400, size=fluid(19px, 26px), leading=1.3em, color=ink, align=center, balance, hyphenate=false, space-after=0.4bl, snap=none]
\style[name=meta, family="Inter, Helvetica Neue, sans-serif", weight=600, size=12px, leading=1.5em, case=upper, tracking=0.14em, color=ink, align=center, space-after=0, snap=none]

%% ---------- around the text ----------
\style[name=pullquote, family="Newsreader, Georgia, serif", italic, weight=400, size=fluid(22px, 32px), leading=1.25em, color=ink, align=left, hyphenate=false, balance]
\style[name=caption, family="Inter, Helvetica Neue, sans-serif", weight=600, size=13px, leading=1.4em, color=ink]
\style[name=credit, family="Inter, Helvetica Neue, sans-serif", size=11px, case=upper, tracking=0.08em, color=muted]
