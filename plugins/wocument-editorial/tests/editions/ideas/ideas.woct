%% The Ideas Issue: an expressive edition theme. Colours come from the collage illustrations
%% (cream paper, navy ink, tomato, mustard, sky and sage). Display type is Inter at its heaviest,
%% tightly tracked; reading type is Newsreader. Both ship with the typesetter.

%% ---------- colour ----------
\token[name=cream, value=#f3ecdf]
\token[name=navy, value=#1d2440]
\token[name=tomato, value=#b23d1d]
\palette[name=default, paper=$cream, ink=$navy, muted=#545a70, accent=$tomato, rule=#ddd2bd]
\palette[name=night, paper=#161b33, ink=#f3ecdf, muted=#b9bdcd, accent=#efbd68, rule=#313a5c]
\palette[name=tomato, paper=#a33618, ink=#fff6ec, muted=#ffe3d2, accent=#ffd98f, rule=#cf5b3a]
\palette[name=mustard, paper=#ebb95f, ink=#1d2440, muted=#3b3a4a, accent=#7e2610, rule=#cf9c44]
\palette[name=sky, paper=#c3d8ec, ink=#1d2440, muted=#36425f, accent=#8a2a12, rule=#a2bcd6]
\palette[name=sage, paper=#cbdab0, ink=#1d2440, muted=#36433a, accent=#7e2610, rule=#aabd8b]

%% ---------- display type ----------
\style[name=headline, family="Inter, Helvetica Neue, Arial, sans-serif", weight=900, size=fluid(52px, 136px), tracking=-0.05em, color=ink]
\style[name=headline-poster, extends=headline, fit=width, fit-max=360px]
\style[name=headline-mid, extends=headline, size=fluid(40px, 92px)]
\style[name=deck, family="Newsreader, Georgia, serif", italic, size=fluid(22px, 32px), color=ink]
\style[name=kicker, family="Inter, Helvetica Neue, Arial, sans-serif", weight=800, size=13px, tracking=0.16em, color=accent]
\style[name=byline, family="Inter, Helvetica Neue, Arial, sans-serif", weight=700, size=13px, case=upper, tracking=0.12em, color=ink]
\style[name=subhead, family="Inter, Helvetica Neue, Arial, sans-serif", weight=900, size=17px, tracking=0.06em, color=accent]
\style[name=pullquote, family="Inter, Helvetica Neue, Arial, sans-serif", italic=false, weight=900, size=fluid(28px, 46px), tracking=-0.03em, color=accent]
\style[name=lede, family="Newsreader, Georgia, serif", size=26px, color=ink]
\style[name=lede, at=compact, size=22px]
\style[name=lede, at=phone, size=21px]

%% ---------- small parts ----------
\style[name=caption, family="Inter, Helvetica Neue, Arial, sans-serif", italic=false, size=13px, color=muted]
\style[name=credit, family="Inter, Helvetica Neue, Arial, sans-serif", size=11px, tracking=0.1em]
\style[name=bignum, family="Inter, Helvetica Neue, Arial, sans-serif", weight=900, size=44px, leading=2bl, tracking=-0.04em, case=none, color=accent, space-before=1bl, space-after=0, keep-with-next=true]
\style[name=entry, family="Inter, Helvetica Neue, Arial, sans-serif", weight=800, size=20px, leading=1bl, tracking=-0.01em, case=none, color=ink, space-before=0, space-after=0, keep-with-next=true]
\style[name=toc-line, family="Newsreader, Georgia, serif", size=18px, leading=1bl, case=none, tracking=0em, color=ink, align=left, hyphenate=false, space-before=0, space-after=0]
\style[name=question, extends=subhead, case=none, tracking=-0.02em, size=fluid(22px, 30px), color=accent, hyphenate=false, balance=true]
\style[name=island, extends=subhead, case=none, tracking=-0.01em, size=22px, color=ink, hyphenate=false]
\style[name=island-num, family="Inter, Helvetica Neue, Arial, sans-serif", weight=900, color=accent]

%% ---------- scene templates ----------
\parent[name=interlude, height=screen, palette=night, folio=hide]
